# Copy to .env and fill in the values you use. Never commit .env or certificates.
# Aiven Kafka: only needed for application-event streaming.
AIVEN_KAFKA_SERVICE_URI=your-service.aivencloud.com:17072
AIVEN_KAFKA_TOPIC=application-events
AIVEN_KAFKA_AUTH_METHOD=sasl
AIVEN_KAFKA_CA_CERT_PATH=certs/ca.pem
AIVEN_KAFKA_SASL_USERNAME=
AIVEN_KAFKA_SASL_PASSWORD=
# For client_certificate auth instead of SASL:
AIVEN_KAFKA_SERVICE_CERT_PATH=certs/service.cert
AIVEN_KAFKA_SERVICE_ACCESS_KEY_PATH=certs/service.key

# Optional OpenAI knowledge article generation.
OPENAI_API_KEY=

# Databricks Volume upload: fill these in for your workspace and existing Volume.
# DATABRICKS_HOST is the full workspace URL, not the account console URL.
DATABRICKS_HOST=https://YOUR-WORKSPACE-URL
DATABRICKS_TOKEN=YOUR-PERSONAL-ACCESS-TOKEN
DATABRICKS_VOLUME_PATH=/Volumes/YOUR_CATALOG/YOUR_SCHEMA/YOUR_VOLUME/cloudflow
